async function readMatrix(rows, cols, name = "Matrix") {
    const readline = require('readline').createInterface({
        input: process.stdin,
        output: process.stdout
    });

    const matrix = [];
    console.log(`\nEnter ${name} (${rows} x ${cols}):`);

    for (let i = 0; i < rows; i++) {
        while (true) {
            const rowInput = await new Promise(resolve => {
                readline.question(`Row ${i+1}: `, resolve);
            });
            const parts = rowInput.trim().split(/\s+/);
            if (parts.length === cols) {
                const row = parts.map(parseFloat);
                if (row.some(isNaN)) {
                    console.log("Invalid input. Please enter numbers only.");
                } else {
                    matrix.push(row);
                    break;
                }
            } else {
                console.log(`Please enter exactly ${cols} numbers.`);
            }
        }
    }
    readline.close();
    return matrix;
}

