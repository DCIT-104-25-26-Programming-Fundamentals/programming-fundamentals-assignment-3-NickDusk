        if (score >= 80) grade = 'A';
        else if (score >= 70) grade = 'B';
        else if (score >= 60) grade = 'C';
        else if (score >= 50) grade = 'D';
        else grade = 'F';

        console.log(`\nScore: ${score}`);
        console.log(`Grade: ${grade}`);
    } catch (error) {
        console.log("Error: Please enter a valid number.");
