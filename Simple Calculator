function addTask(tasks) {
    const readline = require('readline').createInterface({
        input: process.stdin,
        output: process.stdout
    });

    return new Promise(resolve => {
        readline.question("Enter task: ", (task) => {
            tasks.push(task);
            console.log(`Task added: "${task}"`);
            readline.close();
            resolve();
        });
    });
}

function viewTasks(tasks) {
    if (tasks.length === 0) {
        console.log("\nYour to-do list is empty.");
    } else {
        console.log("\nYour Tasks:");
        tasks.forEach((task, i) => {
            console.log(`${i+1}. ${task}`);
        });
    }
}

function deleteTask(tasks) {
    const readline = require('readline').createInterface({
        input: process.stdin,
        output: process.stdout
    });

    return new Promise(resolve => {
        if (tasks.length === 0) {
            console.log("Nothing to delete.");
            readline.close();
            resolve();
            return;
        }

        viewTasks(tasks);
        readline.question("Enter task number to delete: ", (numInput) => {
            const num = parseInt(numInput);
            if (!isNaN(num) && num >= 1 && num <= tasks.length) {
                const removed = tasks.splice(num-1, 1)[0];
                console.log(`Task "${removed}" has been removed.`);
            } else {
                console.log("Invalid task number.");
            }
            readline.close();
            resolve();
        });
    });
}

