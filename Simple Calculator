function displayMenu() {
    console.log("\n" + "=".repeat(40));
    console.log("        SIMPLE CALCULATOR");
    console.log("=".repeat(40));
    console.log("1. Addition");
    console.log("2. Subtraction");
    console.log("3. Multiplication");
    console.log("4. Division");
    console.log("5. Modulus");
    console.log("6. Exponentiation");
    console.log("7. Quit");
    console.log("=".repeat(40));
}

function getNumbers() {
    const readline = require('readline').createInterface({
        input: process.stdin,
        output: process.stdout
    });

    return new Promise((resolve) => {
        readline.question("Enter first number: ", (num1Input) => {
            readline.question("Enter second number: ", (num2Input) => {
                const num1 = parseFloat(num1Input);
                const num2 = parseFloat(num2Input);
                readline.close();
                
                if (isNaN(num1) || isNaN(num2)) {
                    console.log("Error: Please enter valid numbers.");
                    resolve([null, null]);
                } else {
                    resolve([num1, num2]);
                }
            });
        });
    });
}

function addition(num1, num2) { return num1 + num2; }
function subtraction(num1, num2) { return num1 - num2; }
function multiplication(num1, num2) { return num1 * num2; }
function division(num1, num2) {
    if (num2 === 0) return "Error: Cannot divide by zero!";
    return num1 / num2;
}
function modulus(num1, num2) {
    if (num2 === 0) return "Error: Cannot calculate modulus by zero!";
    return num1 % num2;
}
function exponentiation(num1, num2) { return num1 ** num2; }

async function main() {
    const readline = require('readline').createInterface({
        input: process.stdin,
        output: process.stdout
    });

    console.log("=".repeat(40));
    console.log("  WELCOME TO THE CALCULATOR");
    console.log("=".repeat(40));

    while (true) {
        displayMenu();
        const choice = await new Promise(resolve => {
            readline.question("Select an operation (1-7): ", resolve);
        });

        if (choice === '7') {
            console.log("\nThank you for using the calculator. Goodbye!");
            readline.close();
            break;
        }

        if (!['1', '2', '3', '4', '5', '6'].includes(choice)) {
            console.log("Error: Invalid choice. Please select 1-7.");
            continue;
        }

        const [num1, num2] = await getNumbers();
        if (num1 === null || num2 === null) continue;

        let result, operator;
        switch (choice) {
            case '1': result = addition(num1, num2); operator = "+"; break;
            case '2': result = subtraction(num1, num2); operator = "-"; break;
            case '3': result = multiplication(num1, num2); operator = "×"; break;
            case '4': result = division(num1, num2); operator = "÷"; break;
            case '5': result = modulus(num1, num2); operator = "%"; break;
            case '6': result = exponentiation(num1, num2); operator = "^"; break;
        }

        if (typeof result === 'string') {
            console.log(`\n${result}`);
        } else {
            console.log(`\n${num1} ${operator} ${num2} = ${result.toFixed(2)}`);
        }
    }
}

