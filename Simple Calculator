async function partA() {
    const readline = require('readline').createInterface({
        input: process.stdin,
        output: process.stdout
    });

    const n = parseInt(await new Promise(resolve => {
        readline.question("How many terms? ", resolve);
    }));
    readline.close();

    if (n <= 0) {
        console.log("Error: N must be positive.");
        return;
    }

    let fib;
    if (n === 1) {
        fib = [0];
    } else if (n === 2) {
        fib = [0, 1];
    } else {
        fib = [0, 1];
        for (let i = 2; i < n; i++) {
            fib.push(fib[fib.length - 1] + fib[fib.length - 2]);
        }
    }

    console.log(`Fibonacci sequence: ${fib.slice(0, n).join(' ')}`);
}

async function partB() {
    const readline = require('readline').createInterface({
        input: process.stdin,
        output: process.stdout
    });

    const num = parseInt(await new Promise(resolve => {
        readline.question("Enter a number to check: ", resolve);
    }));
    readline.close();

    let a = 0, b = 1;
    while (a < num) {
        [a, b] = [b, a + b];
    }

    if (a === num) {
        console.log(`${num} is a Fibonacci number.`);
    } else {
        console.log(`${num} is NOT a Fibonacci number.`);
    }
}

